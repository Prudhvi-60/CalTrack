# PostgreSQL (local). Production uses Railway Postgres DATABASE_URL.
DATABASE_URL=postgresql+psycopg://caltrack:caltrack@localhost:5432/caltrack
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10

# AI (backend only — never put these in frontend env or VITE_* vars)
# Required for the scanner and chat. Leave empty to disable AI.
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=45
AI_MAX_UPLOAD_BYTES=5242880
AI_MIN_CONFIDENCE=0.5

# CORS / frontend origin
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend bind (local). Railway sets PORT in production.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
