# PostgreSQL used by SQLAlchemy/Alembic.
# Local: postgresql+psycopg://caltrack:caltrack@localhost:5432/caltrack
# Production (Render API): paste the existing Neon PostgreSQL connection string.
# Do not leave it empty in production — the app will not fall back to localhost.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10

# AI (backend only — never put these in frontend env or VITE_* vars)
# Required for the scanner and chat. Leave empty to disable AI.
GEMINI_API_KEY=
AI_PROVIDER=Gemini
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=45
AI_MAX_UPLOAD_BYTES=5242880
AI_MIN_CONFIDENCE=0.5

# Optional Hugging Face model provider for experimentation and agent workflows.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/gemma-2-2b-it
ENABLE_HUGGINGFACE=false
SMOLAGENTS_ENABLED=false
GRADIO_ENABLED=false

# CORS / frontend origin (browser origin, not VITE_API_URL or the API origin)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend bind (local). Render supplies PORT in production.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
