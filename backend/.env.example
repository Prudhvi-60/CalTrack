# Copy to backend/.env or the repo-root .env. Never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection used by SQLAlchemy and Alembic.
# Local Docker: postgresql+psycopg://caltrack:caltrack@localhost:5432/caltrack
# Production: the existing Neon PostgreSQL connection string.
# Never put this value in Vercel or VITE_* variables.
# Production never falls back to localhost.
DATABASE_URL=

JWT_SECRET_KEY=

GEMINI_API_KEY=
AI_PROVIDER=Gemini
AI_MODEL=gemini-3.1-flash-lite

# Optional model-provider extensions for experimentation and tool-driven agent workflows.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/gemma-2-2b-it
ENABLE_HUGGINGFACE=false
SMOLAGENTS_ENABLED=false
GRADIO_ENABLED=false

# Browser origin of the frontend (not the API URL). Production: Vercel URL.
FRONTEND_URL=http://localhost:5173

# Extra allowed frontend origins. Do not put http://127.0.0.1:8001 here.
# Production: set this to the same Vercel origin as FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional database pool settings.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_TIMEOUT_SECONDS=45
AI_MAX_UPLOAD_BYTES=5242880

BACKEND_HOST=0.0.0.0
# Local only. Render supplies PORT.
BACKEND_PORT=8000

# Local development seed only; never configure in Render.
CALTRACK_DEMO_PASSWORD=
