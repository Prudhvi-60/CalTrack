# PostgreSQL (Vitaphiles / SQLAlchemy). Production: Railway or Supabase URI.
DATABASE_URL=postgresql+psycopg://vitaphiles:vitaphiles@localhost:5433/vitaphiles

ENVIRONMENT=development
LOG_LEVEL=INFO

JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20

FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Backend only — never VITE_*
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_ENABLED=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
