# Local development: leave empty to use the Vite /api proxy (see vite.config.ts).
VITE_API_URL=
VITE_API_TIMEOUT_MS=30000

# Optional local (skips the Vite proxy; requires CORS on the API):
# VITE_API_URL=http://127.0.0.1:8001

# Production (Vercel): Railway public origin, no trailing slash, no /api/v1 suffix
# VITE_API_URL=https://your-service.up.railway.app
