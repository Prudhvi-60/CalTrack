# Local development: leave empty so Vite proxies /api to FastAPI (same-origin cookies).
# Direct VITE_API_URL=http://127.0.0.1:8001 from http://localhost:5173 is cross-site;
# refresh cookies will not be sent. If you set the API URL, open the app at
# http://127.0.0.1:5173 instead of http://localhost:5173.
VITE_API_URL=
VITE_API_TIMEOUT_MS=30000

# Optional local (CORS required on the API):
# VITE_API_URL=http://127.0.0.1:8001

# Production (Vercel): Railway public origin, no trailing slash, no /api/v1 suffix
# VITE_API_URL=https://your-service.up.railway.app
